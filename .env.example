# Copy this file to `.env.local` and fill in the values.

# Resend API key — create one at https://resend.com/api-keys
# Without it, the contact form falls back to opening a mailto: composer.
RESEND_API_KEY=

# Where messages are delivered (defaults to sushantmg2004@gmail.com)
CONTACT_TO=sushantmg2004@gmail.com

# Verified sender in Resend (default `onboarding@resend.dev` only works for
# sending to the account owner's own email)
CONTACT_FROM=onboarding@resend.dev